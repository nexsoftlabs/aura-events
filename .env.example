# EmailJS (public keys — restrict domains in EmailJS dashboard)
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=

# Display-only contact email (shown on site & template)
VITE_CONTACT_EMAIL_DISPLAY=hello@auraeventservices.in

# WhatsApp: digits only, no + or spaces (e.g. 919876543210)
VITE_WHATSAPP_NUMBER=

# Canonical site URL for SEO (no trailing slash)
VITE_SITE_URL=https://www.auraeventservices.in

# Optional analytics (set VITE_ENABLE_ANALYTICS=true to load GA4)
VITE_ENABLE_ANALYTICS=false
VITE_GA_MEASUREMENT_ID=
