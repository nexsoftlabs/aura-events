# --- Frontend (public; bundled into the browser) ---

# Optional: full API base URL (omit on Vercel to use same-origin /api/*)
# VITE_CONTACT_API_URL=https://www.auraeventservices.in/api

# Legacy EmailJS fallback (only used if /api/contact returns not configured)
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=

# Display-only contact email (shown on site)
VITE_CONTACT_EMAIL_DISPLAY=eventservices.aura@gmail.com

# WhatsApp: digits only, no + or spaces (e.g. 917908293247)
VITE_WHATSAPP_NUMBER=

# Canonical site URL for SEO (no trailing slash)
VITE_SITE_URL=https://www.auraeventservices.in

# Optional analytics (set VITE_ENABLE_ANALYTICS=true to load GA4)
VITE_ENABLE_ANALYTICS=false
VITE_GA_MEASUREMENT_ID=

# --- Vercel serverless only (Project → Settings → Environment Variables) ---
# RESEND_API_KEY=re_...
# RESEND_FROM=Aura Events <info@auraeventservices.in>
# CONTACT_INBOX=eventservices.aura@gmail.com
# ALLOWED_ORIGINS=https://www.auraeventservices.in,https://auraeventservices.in,http://127.0.0.1:5173
